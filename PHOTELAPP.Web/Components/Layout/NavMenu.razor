@implements IDisposable

@inject NavigationManager NavigationManager

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

        <!-- Inicio -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
        <NavLink class="nav-link" href="/cliente/reservar">
                <span class="bi bi-card-list" aria-hidden="true"></span> Reservar
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/cliente/misreservas">
                <span class="bi bi-card-list" aria-hidden="true"></span> Mis Reservas
        </NavLink>
    </div>

        <!-- Páginas visibles SOLO para usuarios autenticados -->
        <AuthorizeView>
            <Authorized>
                <!-- Gestión de Habitaciones -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/habitaciones">
                        <span class="bi bi-building" aria-hidden="true"></span> Habitaciones
                    </NavLink>
                </div>

                <!-- Reservas -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/reservas">
                        <span class="bi bi-calendar-check" aria-hidden="true"></span> Reservas
                    </NavLink>
                </div>

                <!-- Sobre Nosotros (opcional: puedes dejarlo visible siempre o solo logueados) -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/sobrenosotros">
                        <span class="bi bi-info-circle" aria-hidden="true"></span> Sobre Nosotros
                    </NavLink>
                </div>

                <!-- Usuario logueado -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @context.User.Identity?.Name
                    </NavLink>
                </div>

                <!-- Logout -->
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>

            <NotAuthorized>
                <!-- Registro e Inicio de sesión -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login(Empleado)
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}