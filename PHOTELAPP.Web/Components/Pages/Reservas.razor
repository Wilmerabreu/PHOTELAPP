@page "/reservas"

<h3>📅 Gestión de Reservas</h3>

<p>Selecciona una opción para gestionar las reservas de tu hotel:</p>

<div class="d-flex flex-column gap-3 w-50">
    <button class="btn btn-success btn-lg" @onclick="VerReservasActivas">
        🟢 Reservas Activas
    </button>
    <button class="btn btn-primary btn-lg" @onclick="VerSolicitudes">
        🔵 Solicitudes de Reservas
    </button>
</div>

@if (!string.IsNullOrEmpty(Mensaje))
{
    <div class="alert alert-info mt-4" role="alert">
        @Mensaje
    </div>
}

@code {
    private string? Mensaje { get; set; }

    private void VerReservasActivas()
    {
        Mensaje = "Mostrando todas las reservas activas...";
        // Aquí puedes navegar a otra página o cargar una tabla desde la BD
    }

    private void VerSolicitudes()
    {
        Mensaje = "Cargando nuevas solicitudes de reserva...";
        // Aquí puedes mostrar un listado de nuevas solicitudes pendientes
    }
}
@code {

}
